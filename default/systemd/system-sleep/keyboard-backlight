#!/bin/bash

# Turn off keyboard backlight before any sleep operation (suspend, hibernate,
# etc.) and restore it to its prior brightness on wake. Also works around
# hardware (e.g. some ASUS keyboard controllers) that can hang on hibernate
# power-off while backlight LEDs are still active.

device=""
for candidate in /sys/class/leds/*kbd_backlight*; do
  if [[ -e "$candidate" ]]; then
    device="$(basename "$candidate")"
    break
  fi
done

[[ -z $device ]] && exit 0

case "$1" in
  pre) brightnessctl -sd "$device" set 0 >/dev/null 2>&1 ;;
  post) brightnessctl -rd "$device" >/dev/null 2>&1 ;;
esac
