#!/bin/bash

# omarchy:summary=Print the active Omarchy mirror and package channel

if grep -q "https://stable-mirror.omarchy.org/" /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -q "https://rc-mirror.omarchy.org/" /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -q "https://mirror.omarchy.org/" /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

# The package channel lives in the omarchy mirrorlist now, not in pacman.conf:
# one pacman.conf serves every channel. Fall back to pacman.conf for systems
# still carrying an inlined [omarchy] Server.
omarchy_repo_files=(/etc/pacman.d/omarchy-mirrorlist /etc/pacman.conf)

if grep -qs "https://pkgs.omarchy.org/stable/" "${omarchy_repo_files[@]}"; then
  pkgs="stable"
elif grep -qs "https://pkgs.omarchy.org/edge/" "${omarchy_repo_files[@]}"; then
  pkgs="edge"
else
  pkgs="unknown"
fi

if [[ $mirror == $pkgs ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi
