#!/bin/bash

# omarchy:summary=Show or set whether wired Ethernet is a WAN client or shares this machine's connection
# omarchy:group=network
# omarchy:args=[wan|shared|toggle]
# omarchy:examples=omarchy network shared | omarchy network shared shared | omarchy network shared toggle

set -euo pipefail

# Whenever this runs as root — invoked directly through the passwordless
# sudoers rule, or re-execed by require_root below — sudo's secure_path decides
# where a bare helper resolves, and a dev link (etc/sudoers.d/omarchy-dev-path)
# prepends a user-writable checkout bin/ to it. nmcli and ufw are system
# tools and omarchy-cmd-present is an omarchy-* command, never one this script
# should resolve out of a checkout, so pin PATH to trusted system directories
# once root is held. The unprivileged wrapper phase keeps the caller's PATH so
# it can still find sudo/pkexec.
if (( EUID == 0 )); then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
fi

# Shared mode turns the wired port into an uplink for whatever is plugged into
# it: NetworkManager runs its own dnsmasq for DHCP and DNS and sets up NAT to
# the machine's other route. WAN mode is the normal DHCP client.
#
# This is ipv4.method on the wired profile rather than a systemd-networkd
# .network file: Omarchy runs NetworkManager, and install/hardware/network.sh
# actively disables systemd-networkd and retires its DHCP drop-ins so the two
# cannot compete for the same link.

SHARED_ADDRESS="10.42.0.1/24"

# The path etc/sudoers.d/omarchy-network-shared names. The privileged half
# always runs from there rather than from whichever copy was invoked, so the
# rule matches even where $OMARCHY_PATH points at a dev-linked checkout.
PACKAGED_PATH=/usr/bin/omarchy-network-shared

wired_device() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
    awk -F: '$2 == "ethernet" { print $1; exit }'
}

# The UUID, not the name: nmcli -t escapes a colon inside a connection name,
# and a UUID never contains one.
connection_for() {
  local device="$1" uuid

  uuid=$(nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null |
    awk -F: -v device="$device" '$2 == device { print $1; exit }')

  # No active profile when the cable is out; fall back to one bound to the device.
  [[ -n $uuid ]] || uuid=$(nmcli -t -f UUID,DEVICE connection show 2>/dev/null |
    awk -F: -v device="$device" '$2 == device { print $1; exit }')

  printf '%s\n' "$uuid"
}

current_mode() {
  case "$(nmcli -g ipv4.method connection show "$1" 2>/dev/null)" in
    shared) echo "shared" ;;
    *) echo "wan" ;;
  esac
}

# True when sudo would run this exact command without stopping for a password.
# `sudo -l` on its own reports whether a command is permitted, which the blanket
# %wheel rule answers yes to for everything; the long listing prints the matched
# entry's tags, so !authenticate is the grant in etc/sudoers.d/omarchy-network-shared
# and nothing else. Listing runs nothing and, under -n, prompts for nothing, so a
# machine whose omarchy-settings predates that file falls through to polkit
# instead of dying on a password prompt it has no terminal to show.
sudo_grants_passwordless() {
  sudo -n -l -l "$PACKAGED_PATH" "$@" 2>/dev/null | grep -q '!authenticate'
}

require_root() {
  if (( EUID == 0 )); then
    return
  fi

  # PACKAGED_PATH does not exist until an install of Omarchy new enough to
  # carry this command lands at /usr/bin -- a dev checkout can run ahead of
  # that on its own machine. The sudoers grant cannot match a path with
  # nothing there either, so elevate the copy actually running instead of
  # handing sudo/pkexec a target neither can find.
  local target=$PACKAGED_PATH
  [[ -x $target ]] || target=$(realpath -- "$0")

  if [[ -t 0 ]] || sudo_grants_passwordless "$@"; then
    # A terminal can carry sudo's own password prompt. Without one, sudo is
    # right only where the grant reaches; polkit can at least put a prompt on
    # screen, and offer to authenticate as someone else. This is what makes the
    # menu's one-click shared/wan toggle work: it runs detached, with no
    # terminal to show a prompt in.
    exec sudo "$target" "$@"
  else
    exec pkexec "$target" "$@"
  fi
}

# UFW's after.rules sends inbound DHCP-server traffic (port 67) straight to
# the default-deny policy regardless of user rules, to keep noisy broadcast
# traffic out of the log on WAN-facing hosts. That silently swallows the
# DHCPDISCOVER packets from whatever's plugged into a shared connection
# unless we punch an explicit hole for this device. Called only once
# require_root has secured EUID 0, so ufw itself needs no sudo of its own.
open_dhcp_port() {
  omarchy-cmd-present ufw || return 0
  ufw allow in on "$device" to any port 67 proto udp comment "omarchy-network-shared" >/dev/null
  ufw reload >/dev/null
}

close_dhcp_port() {
  omarchy-cmd-present ufw || return 0
  ufw --force delete allow in on "$device" to any port 67 proto udp >/dev/null 2>&1 || true
  ufw reload >/dev/null
}

device=$(wired_device)
if [[ -z $device ]]; then
  echo "No wired Ethernet device found" >&2
  exit 1
fi

connection=$(connection_for "$device")
if [[ -z $connection ]]; then
  echo "No NetworkManager profile for $device; connect the wired link once so a profile exists" >&2
  exit 1
fi

mode="${1:-}"

# No argument reports, matching omarchy-network-band and the DNS entries the
# menu drives; toggle is the explicit verb.
if [[ -z $mode ]]; then
  current_mode "$connection"
  exit 0
fi

if [[ $mode == "toggle" ]]; then
  if [[ $(current_mode "$connection") == "shared" ]]; then
    mode=wan
  else
    mode=shared
  fi
fi

case $mode in
  shared)
    require_root shared
    # Pinning the address keeps the subnet stable across reconnects; left to
    # NetworkManager it picks a free 10.42.x.0/24 that can move.
    nmcli connection modify "$connection" ipv4.method shared ipv4.addresses "$SHARED_ADDRESS"
    nmcli connection up "$connection" >/dev/null
    open_dhcp_port
    echo "Wired ($device): sharing this machine's connection, DHCP server at ${SHARED_ADDRESS%/*}"
    ;;
  wan)
    require_root wan
    # ipv4.addresses has to be cleared or it survives as a static address.
    nmcli connection modify "$connection" ipv4.method auto ipv4.addresses ""
    nmcli connection up "$connection" >/dev/null
    close_dhcp_port
    echo "Wired ($device): WAN mode (DHCP client)"
    ;;
  *)
    echo "Usage: omarchy network shared [wan|shared|toggle]" >&2
    exit 1
    ;;
esac
