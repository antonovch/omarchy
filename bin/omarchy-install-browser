#!/bin/bash

# omarchy:summary=Install a supported browser
# omarchy:args=<chrome|brave|brave-origin|edge|firefox|zen>
# omarchy:examples=omarchy install browser firefox | omarchy install browser brave

source "$OMARCHY_PATH/install/helpers/browser-policy.sh"

setup_chromium_policy_directory() {
  browser_policy_setup_dir "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "$OMARCHY_PATH/config/chromium-flags.conf" "$1"
  omarchy-install-chromium-copy-url
  omarchy-install-chromium-ytdlp
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/omarchy-firefox-wayland.conf
}

# Apply policies + autoconfig to a Firefox install root (the directory holding
# the firefox binary), e.g. /usr/lib/firefox or the firefoxpwa runtime. Takes the
# distribution dir so existing callers keep working.
setup_firefox_preferences() {
  local distribution_dir="$1"
  local install_root="${distribution_dir%/distribution}"
  local xpi="$OMARCHY_PATH/default/firefox/theme-switcher/remote-theme-switcher@local.xpi"
  local staged

  staged=$(mktemp) || return 1
  sed "s|@@THEME_SWITCHER_XPI@@|file://$xpi|" "$OMARCHY_PATH/default/firefox/policies.json" >"$staged"

  # The runtime under $HOME is user-owned; /usr/lib and /opt are not, and get
  # the same root-hardened install as the Chromium-family policy directories.
  if [[ -w $install_root ]]; then
    mkdir -p "$distribution_dir"
    cp -f "$staged" "$distribution_dir/policies.json"
  else
    browser_policy_setup_parent "$distribution_dir"
    browser_policy_purge_dir "$distribution_dir"
    browser_policy_install_firefox_policies "$distribution_dir" "$staged"
  fi
  rm -f "$staged"

  # autoconfig.js points Firefox at firefox.cfg for defaultPref overrides that
  # the policy schema can't express.
  local sudo_prefix="sudo"
  [[ -w $install_root ]] && sudo_prefix=""
  $sudo_prefix mkdir -p "$install_root/defaults/pref"
  $sudo_prefix cp -f "$OMARCHY_PATH/default/firefox/firefox.cfg" "$install_root/firefox.cfg"
  $sudo_prefix cp -f "$OMARCHY_PATH/default/firefox/autoconfig.js" "$install_root/defaults/pref/autoconfig.js"
}

# The firefoxpwa runtime is a second, private Firefox that policies in
# /usr/lib/firefox do not reach, so web apps would otherwise run unhardened and
# unthemed. Give it the same treatment.
setup_firefox_pwa() {
  omarchy-pkg-aur-add firefoxpwa || {
    echo "Warning: firefoxpwa unavailable; web apps will fall back to Chromium."
    return 0
  }

  local runtime_dir="${XDG_DATA_HOME:-$HOME/.local/share}/firefoxpwa/runtime"

  if [[ ! -x $runtime_dir/firefox ]]; then
    echo "Installing the firefoxpwa runtime..."
    firefoxpwa runtime install --link 2>/dev/null ||
      firefoxpwa runtime install ||
      echo "Warning: could not install the firefoxpwa runtime."
  fi

  [[ -d $runtime_dir ]] && setup_firefox_preferences "$runtime_dir/distribution"
}

# Bridge omarchy-theme-firefox-set to the theme-switcher extension. The manifest
# is shared by every Firefox install for this user, runtime included.
setup_firefox_theme_switcher() {
  local host_dir="$HOME/.mozilla/native-messaging-hosts"
  local host_bin="$HOME/.local/bin/firefox_theme_host.py"

  mkdir -p "$(dirname "$host_bin")" "$host_dir" "$HOME/.config/firefox-theme-switcher"
  install -m 0755 "$OMARCHY_PATH/default/firefox/theme-switcher/firefox_theme_host.py" "$host_bin"

  cat >"$host_dir/com.local.theme_switcher.json" <<EOF
{
  "name": "com.local.theme_switcher",
  "description": "Bridge to switch Firefox theme from a local UNIX socket",
  "path": "$host_bin",
  "type": "stdio",
  "allowed_extensions": ["remote-theme-switcher@local"]
}
EOF
}

case $1 in
chrome)
  echo "Installing Chrome..."
  omarchy-pkg-aur-add google-chrome || exit 1

  setup_chromium_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  omarchy-theme-set-browser
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  omarchy-pkg-aur-add microsoft-edge-stable-bin || exit 1

  setup_chromium_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags ~/.config/microsoft-edge-stable-flags.conf
  omarchy-theme-set-browser
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  omarchy-pkg-aur-add brave-bin || exit 1

  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  omarchy-theme-set-browser
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  omarchy-pkg-aur-add brave-origin-bin || exit 1

  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-origin-flags.conf
  omarchy-theme-set-browser
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  omarchy-pkg-add firefox || exit 1

  setup_firefox_preferences /usr/lib/firefox/distribution
  setup_firefox_wayland
  setup_firefox_theme_switcher
  setup_firefox_pwa
  omarchy-theme-set-browser
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  omarchy-pkg-aur-add zen-browser-bin || exit 1

  setup_firefox_preferences /opt/zen-browser/distribution
  setup_firefox_wayland
  announce_browser_installed "Zen"
  ;;
*)
  echo "Usage: omarchy-install-browser <chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
