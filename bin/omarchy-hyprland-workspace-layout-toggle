#!/bin/bash

# omarchy:summary=Toggle the layout on the current active workspace between dwindle and scrolling

ACTIVE_WORKSPACE=$(hyprctl activeworkspace -j | jq -r '.id')
CURRENT_LAYOUT=$(hyprctl activeworkspace -j | jq -r '.tiledLayout')

case "$CURRENT_LAYOUT" in
  dwindle) NEW_LAYOUT=scrolling ;;
  *) NEW_LAYOUT=dwindle ;;
esac

hyprctl eval "hl.workspace_rule({ workspace = \"$ACTIVE_WORKSPACE\", layout = \"$NEW_LAYOUT\" })" >/dev/null 2>&1 || \
  hyprctl keyword workspace $ACTIVE_WORKSPACE, layout:$NEW_LAYOUT

# Persist layout so it survives reloads and monitor changes
LAYOUTS_STATE="$HOME/.local/state/omarchy/workspace-layouts"
LAYOUTS_LUA="$HOME/.config/omarchy/workspace-layouts.lua"
mkdir -p "$LAYOUTS_STATE"

if [[ "$NEW_LAYOUT" == "dwindle" ]]; then
  rm -f "$LAYOUTS_STATE/$ACTIVE_WORKSPACE"
else
  echo "$NEW_LAYOUT" > "$LAYOUTS_STATE/$ACTIVE_WORKSPACE"
fi

# Regenerate Lua config so workspace rules reload with Hyprland
{
  for f in "$LAYOUTS_STATE"/*; do
    [[ -f "$f" ]] || continue
    echo "hl.workspace_rule({ workspace = \"$(basename "$f")\", layout = \"$(cat "$f")\" })"
  done
} > "$LAYOUTS_LUA"

notify-send -u low "󱂬    Workspace layout set to $NEW_LAYOUT"
