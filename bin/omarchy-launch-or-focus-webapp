#!/bin/bash

# omarchy:summary=Launch or focus on a given web app identified by the window-pattern.
# omarchy:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: omarchy-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
# Pass the pattern on as the web app name too: it is the binding description, so
# it is what omarchy-launch-webapp needs to resolve a firefoxpwa site by name.
LAUNCH_COMMAND="omarchy-launch-webapp $(printf '%q' "$1") $(printf '%q' "$WINDOW_PATTERN") ${*:2}"

exec omarchy-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
